# 复制为 .env 后按需修改，docker compose 会自动读取

# 上游地址，不要带 /v1
UPSTREAM_BASE_URL=https://api.tokenjuice.ai

# 密钥默认由 new-api 传入（转发调用方的 Authorization / x-api-key / api-key），
# 这里留空即可。只有当调用方完全不带密钥时，才用下面的值兜底。
UPSTREAM_API_KEY=

# 客户端模型名 → 上游模型名
MODEL_MAP={"deepseek-v4.1-flash-1017-tj":"deepseek-ai/DeepSeek-V4.1-Flash-1017"}

# /v1/messages 上游协议：chat_completions（默认）或 responses
UPSTREAM_API=chat_completions

# 仅原生 POST /v1/responses：删除顶层 previous_response_id / conversation
# 客户端须每次发送完整历史；这是兼容实验，不保证解除上游十轮限制
RESPONSES_STATELESS=false
# 可选删除的会话头（逗号分隔），默认不删任何头。仅支持：
# Session-Id、X-Session-Id、Conversation-Id、X-Conversation-Id
RESPONSES_STATELESS_DROP_HEADERS=

# 是否把 output_config.effort 转成 reasoning_effort
PASS_REASONING_EFFORT=true

# 非流式请求超时
UPSTREAM_TIMEOUT=10m

# 上游代理。可以直接写宿主机局域网 IP，例如 192.168.31.109:7890（不写 http:// 也行）；
# 代理只监听 127.0.0.1 时改用 host.docker.internal:7890（compose 已加 host-gateway 映射）。
# 注意容器里的 127.0.0.1 是容器自己，不能用。
# 留空时使用容器环境里的 HTTP_PROXY / HTTPS_PROXY / NO_PROXY
UPSTREAM_PROXY=

# 打印转换后的上游请求体（排查 400 时临时打开）
LOG_BODIES=false

# 宿主机端口
BRIDGE_PORT=8080
